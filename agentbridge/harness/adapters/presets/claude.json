{
  "id": "claude",
  "label": "Claude Code",
  "command": "claude",
  "args": ["-p", "{prompt}", "--output-format", "stream-json", "--verbose",
           "--max-turns", "60"],
  "args_minimal": ["-p", "{prompt}", "--output-format", "stream-json",
                   "--verbose"],
  "bridge_unavailable_reason": "bridge isolation is not verified for this installed provider",
  "native_profile": {
    "schema": 1,
    "provider": "claude",
    "inventory_complete": false,
    "enforcement_locus": "provider-deny-flags+optional-agentbridge-broker",
    "evidence": "reviewed shipped preset; installed provider version and exhaustive inventory remain unverified",
    "auto_allow": ["claude.file_read", "claude.file_glob",
                   "claude.file_grep", "claude.todo_write"],
    "blocked": ["claude.file_write", "claude.file_edit", "claude.shell",
                "claude.web_fetch", "claude.web_search",
                "claude.task", "claude.agent", "claude.notebook_edit",
                "claude.kill_shell", "claude.ask_user"],
    "aux_web": ["claude.web_fetch", "claude.web_search"]
  },
  "env_allow": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN",
                "ANTHROPIC_BASE_URL", "CLAUDE_CODE_OAUTH_TOKEN",
                "CLAUDE_CONFIG_DIR",
                "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX",
                "ANTHROPIC_VERTEX_PROJECT_ID", "CLOUD_ML_REGION",
                "AWS_PROFILE", "AWS_REGION", "AWS_DEFAULT_REGION",
                "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY",
                "AWS_SESSION_TOKEN", "AWS_WEB_IDENTITY_TOKEN_FILE",
                "AWS_ROLE_ARN", "GOOGLE_APPLICATION_CREDENTIALS"],
  "model_args": ["--model", "{model}"],
  "effort_args": ["--effort", "{effort}"],
  "efforts": ["low", "medium", "high", "xhigh", "max"],
  "blocklist_args": ["--disallowedTools", "{tool}"],
  "format": "claude-stream",
  "models": ["claude-fable-5", "claude-opus-4-8", "claude-sonnet-5",
             "claude-haiku-4-5-20251001"],
  "verified": true
}
