{
  "id": "cortex",
  "label": "Cortex Code (Snowflake)",
  "command": "cortex",
  "args": ["-w", "{workdir}", "--auto-accept-plans", "--max-turns", "60",
           "--output-format", "stream-json", "-p", "{prompt}"],
  "args_minimal": ["--max-turns", "60", "--output-format", "stream-json",
                   "-p", "{prompt}"],
  "safety_args": ["--sql-read-only"],
  "env_allow": ["SNOWFLAKE_ACCOUNT", "SNOWFLAKE_USER",
                "SNOWFLAKE_PASSWORD", "SNOWFLAKE_AUTHENTICATOR",
                "SNOWFLAKE_PRIVATE_KEY_PATH", "SNOWFLAKE_ROLE",
                "SNOWFLAKE_WAREHOUSE", "SNOWFLAKE_DATABASE",
                "SNOWFLAKE_SCHEMA", "CORTEX_BASE_URL"],
  "model_args": ["--model", "{model}"],
  "blocklist_args": ["--disallowed-tools", "{tool}"],
  "native_profile": {
    "schema": 2,
    "provider": "cortex",
    "inventory_complete": false,
    "enforcement_locus": "provider-deny-flags+optional-agentbridge-broker",
    "evidence": "reviewed shipped preset; installed provider version and exhaustive inventory remain unverified",
    "auto_allow": [],
    "blocked": ["cortex.file_read", "cortex.file_write", "cortex.file_edit",
                "cortex.file_glob", "cortex.file_grep", "cortex.shell",
                "cortex.shell_output", "cortex.kill_shell",
                "cortex.python_repl", "cortex.web_fetch", "cortex.web_search",
                "cortex.cron_create", "cortex.cron_delete", "cortex.cron_list",
                "cortex.notebook_execute", "cortex.notebook_actions",
                "cortex.run_subagent", "cortex.review", "cortex.team_create",
                "cortex.team_delete", "cortex.send_message", "cortex.ask_user",
                "cortex.sql_execute", "cortex.object_search",
                "cortex.product_docs", "cortex.semantic_validate",
                "cortex.analyst", "cortex.data_diff", "cortex.plan_enter",
                "cortex.plan_exit", "cortex.memory"],
    "aux_web": []
  },
  "reply_file_arg": ["-o", "{reply_file}"],
  "format": "claude-stream",
  "verified": false
}
