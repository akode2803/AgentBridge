{
  "id": "codex",
  "label": "Codex CLI",
  "command": "codex",
  "args": ["exec", "--json", "--skip-git-repo-check", "-C", "{workdir}",
           "{prompt}"],
  "args_minimal": ["exec", "--json", "{prompt}"],
  "safety_args": ["--sandbox", "read-only", "--ignore-user-config"],
  "permission_args": [
    "-c", "approval_policy=\"never\"",
    "-c", "mcp_servers.ab.url=\"{mcp_url}\"",
    "-c", "mcp_servers.ab.bearer_token_env_var=\"AGENTBRIDGE_MCP_TOKEN\"",
    "-c", "mcp_servers.ab.default_tools_approval_mode=\"prompt\"",
    "-c", "mcp_servers.ab.tools.delegate_agent.approval_mode=\"approve\"",
    "-c", "mcp_servers.ab.tool_timeout_sec=960"
  ],
  "env_allow": ["OPENAI_API_KEY", "OPENAI_BASE_URL", "CODEX_HOME",
                "CODEX_EVERYWHERE_API_KEY"],
  "model_args": ["-m", "{model}"],
  "effort_args": ["-c", "model_reasoning_effort={effort}"],
  "efforts": ["minimal", "low", "medium", "high"],
  "format": "codex-jsonl",
  "models": ["gpt-5.1-codex", "gpt-5.1-codex-mini"],
  "verified": false
}
