{
  "id": "codex",
  "label": "Codex CLI",
  "command": "codex",
  "args": ["exec", "--json", "--skip-git-repo-check", "-C", "{workdir}",
           "{prompt}"],
  "args_minimal": ["exec", "--json", "{prompt}"],
  "safety_args": ["--sandbox", "read-only", "--ignore-user-config",
                  "--ignore-rules", "--ephemeral"],
  "bridge_profile": {
    "schema": 1,
    "provider": "codex",
    "renderer": "codex-0.144",
    "transport": "streamable-http-bearer",
    "version_args": ["--version"],
    "version_pattern": "^codex-cli 0\\.144\\.5$",
    "enforcement_locus": "provider-filter+server-authority",
    "config_isolation": "ignore-user-config",
    "continuation": "fresh-only",
    "capabilities": ["delegate_agent"],
    "safe_overlay_keys": ["model_context_window",
                          "model_auto_compact_token_limit",
                          "personality", "service_tier"],
    "blocked_env": ["OPENAI_API_KEY", "OPENAI_BASE_URL",
                    "CODEX_EVERYWHERE_API_KEY", "HTTP_PROXY", "HTTPS_PROXY",
                    "ALL_PROXY", "http_proxy", "https_proxy", "all_proxy"]
  },
  "env_allow": ["CODEX_HOME"],
  "model_args": ["-m", "{model}"],
  "effort_args": ["-c", "model_reasoning_effort={effort}"],
  "efforts": ["minimal", "low", "medium", "high"],
  "format": "codex-jsonl",
  "models": ["gpt-5.1-codex", "gpt-5.1-codex-mini"],
  "verified": false
}
